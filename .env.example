# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- Required ---
# Token from @BotFather.
BOT_TOKEN=
# Bot username without the @.
BOT_USERNAME=
# Comma-separated ids of the supergroups the bot serves. Updates from anywhere
# else are dropped. A supergroup id looks like -1001234567890.
ALLOWED_CHAT_IDS=
# Database credentials used by both the bot and the postgres container.
DB_USER=newsbot
DB_PASSWORD=change-me

# --- Optional ---
# Who may run admin commands. Empty means every member of an allowed chat.
ADMIN_USER_IDS=
# How often sources are polled, in minutes.
POLL_INTERVAL_MINUTES=30
# Maximum news messages per topic per cycle.
MAX_ITEMS_PER_TOPIC=5
# How far back an article may have been published to still count as fresh.
NEWS_LOOKBACK_HOURS=24
# Prefix marking the topics the bot owns.
TOPIC_PREFIX=news-
# Subjects created automatically on start-up, e.g. it,science,ai. Idempotent.
BOOTSTRAP_TOPICS=
# Pin the welcome message (needs can_pin_messages).
WELCOME_PIN=true
# Read an ambiguous topic name once with the model and store what it means:
# "java" as the language and not the island. false = search for the name itself.
TOPIC_PROFILE=true
# Outbound throttle. Telegram allows about 20 messages per minute per group.
SEND_RATE_PER_MINUTE=17
# Link preview policy: FIRST_ONLY | ALWAYS | NEVER
LINK_PREVIEW=FIRST_ONLY
# How long a sent article is remembered for de-duplication.
SEEN_RETENTION_DAYS=30
# Topic filters (/exclude, /include): let the summariser's model also judge an
# article by meaning, not only by the literal word. false = keywords only.
FILTER_AI_CHECK=true
# How many filter terms one topic may hold.
FILTER_MAX_TERMS_PER_TOPIC=30
LOG_LEVEL=INFO
# Host port for /actuator/health. Change it when something else already listens
# on 8080 — for instance the bot started from an IDE.
JOURNALIST_PORT=8080

# --- Summaries ---
# ollama     - local model in the ollama container (default, free, no key)
# anthropic  - hosted Claude, needs LLM_API_KEY and costs money per article
# extractive - no model at all, just the first sentences of the feed description
SUMMARIZER=ollama

# Model pulled into the ollama container on first start. Keep it small: the
# container is capped at 3 GB in docker-compose.yml. Alternatives that fit:
# qwen2.5:3b, gemma2:2b, phi3.5:3.8b
OLLAMA_MODEL=llama3.2:3b
# How long one summary may take. A 3B model on CPU needs 10-60 s per article.
OLLAMA_TIMEOUT_SECONDS=120

# Only for SUMMARIZER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-opus-5
LLM_MAX_CALLS_PER_HOUR=100
